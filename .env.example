# ==============================================================================
# inspiro LIVE - Environment Variables for Local Dev and Vercel Deployment
# ==============================================================================

# Required: Google Gemini API Key for AI paper parsing, scheduling, & remedial PYQs.
# Get a free key with generous limits at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="AIzaSy..."

# Alternative name supported by Vite and Vercel (optional, server automatically detects either):
# VITE_GEMINI_API_KEY="AIzaSy..."

# Server Port (Defaults to 3000 locally; ignored on Vercel Serverless)
PORT=3000

# Node Environment ('development' locally, 'production' on Vercel)
NODE_ENV="development"
